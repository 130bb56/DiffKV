+  Float8_ out;
+  out.x = dequant(uint8[0], scale, zero_point);
+  out.y = dequant(uint8[1], scale, zero_point);
+  out.z = dequant(uint8[2], scale, zero_point);
+  out.w = dequant(uint8[3], scale, zero_point);
