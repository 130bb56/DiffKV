+  asm volatile("cvt.rni.sat.u8.f32 %0, %1;" : "=h"(uint16[4]) : "f"((in.z.x - zero_point) * inv_scale));
+  asm volatile("cvt.rni.sat.u8.f32 %0, %1;" : "=h"(uint16[5]) : "f"((in.z.y - zero_point) * inv_scale));
